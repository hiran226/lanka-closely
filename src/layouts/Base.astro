---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}
const {
  title,
  description = 'A field guide to reading Sri Lanka — the moonstones, guardstones, stupas, tanks, gopurams and gateways that make its places mean something.',
  image,
} = Astro.props;
const fullTitle = title ? `${title} · Lanka, Closely` : 'Lanka, Closely — a field guide to reading Sri Lanka';
const path = Astro.url.pathname;
const nav = [
  { href: '/', label: 'Plates', match: (p: string) => p === '/' || p.startsWith('/plates') },
  { href: '/where-to-look/', label: 'Where to look', match: (p: string) => p.startsWith('/where-to-look') },
  { href: '/how-to-look/', label: 'How to look', match: (p: string) => p.startsWith('/how-to-look') },
  { href: '/about/', label: 'About', match: (p: string) => p.startsWith('/about') },
];
const canonical = new URL(path, Astro.site).toString();
---
<!doctype html>
<html lang="en-GB" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {image && <meta property="og:image" content={new URL(image, Astro.site).toString()} />}
    <meta name="theme-color" content="#f3ecdf" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#15120f" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="google-site-verification" content="z3ai35IuMVA-oTRwrksXyqF0P3wjNxdvcs17Vsmoszg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Newsreader:ital,opsz,wght@0,6..72,300..700;1,6..72,300..700&family=Noto+Serif+Sinhala:wght@400;600&family=Noto+Serif+Tamil:wght@400;600&display=swap"
    />
    <script is:inline>
      document.documentElement.classList.remove('no-js');
      try {
        var t = localStorage.getItem('lc-theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-head">
      <div class="wrap head-inner">
        <a href="/" class="brand" aria-label="Lanka, Closely — home">
          <svg class="brand-mark" viewBox="0 0 40 22" aria-hidden="true">
            <path d="M1 21a19 19 0 0 1 38 0" fill="none" stroke="currentColor" stroke-width="1.4" />
            <path d="M6 21a14 14 0 0 1 28 0" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="1.6 1.6" />
            <path d="M11 21a9 9 0 0 1 18 0" fill="none" stroke="currentColor" stroke-width="1" />
            <path d="M15.5 21a4.5 4.5 0 0 1 9 0Z" fill="currentColor" />
          </svg>
          <span class="brand-word">Lanka, <em>Closely</em></span>
        </a>
        <nav aria-label="Main" class="nav">
          <ul>
            {nav.map((n) => (
              <li>
                <a href={n.href} aria-current={n.match(path) ? 'page' : undefined}>{n.label}</a>
              </li>
            ))}
          </ul>
        </nav>
        <button class="theme-btn" type="button" aria-label="Switch colour theme" title="Switch colour theme">
          <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="7.2" fill="none" stroke="currentColor" stroke-width="1.3"/><path d="M10 2.8a7.2 7.2 0 0 1 0 14.4Z" fill="currentColor"/></svg>
        </button>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-foot">
      <div class="wrap foot-inner">
        <div class="foot-brand">
          <p class="foot-title">Lanka, <em>Closely</em></p>
          <p class="foot-line">A field guide to the details that make Sri Lanka's places legible. Read it before you go; open it when you're standing there.</p>
        </div>
        <div class="foot-cols">
          <ul>
            <li><a href="/">The plates</a></li>
            <li><a href="/where-to-look/">Where to look</a></li>
            <li><a href="/how-to-look/">How to look, respectfully</a></li>
            <li><a href="/about/">About &amp; sources</a></li>
            <li><a href="/about/#credits">Image credits</a></li>
          </ul>
          <p class="foot-note">
            A personal, non-commercial project. Photographs from Wikimedia Commons under the licences credited on each page.
            Facts are sourced; interpretations that scholars dispute are marked as such.
          </p>
        </div>
      </div>
    </footer>

    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>

<style>
  .site-head {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: saturate(1.2) blur(10px);
    -webkit-backdrop-filter: saturate(1.2) blur(10px);
    border-bottom: 1px solid var(--rule);
  }
  .head-inner { display: flex; align-items: center; gap: 24px; min-height: 60px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; color: var(--ink); }
  .brand-mark { width: 34px; height: auto; color: var(--laterite); }
  .brand-word { font-family: var(--f-display); font-size: 1.28rem; letter-spacing: -0.01em; white-space: nowrap; }
  .brand-word em { font-style: italic; }
  .nav { margin-left: auto; }
  .nav ul { list-style: none; display: flex; gap: clamp(14px, 2.4vw, 30px); margin: 0; padding: 0; }
  .nav a {
    font-family: var(--f-mono); font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase;
    text-decoration: none; color: var(--ink-2); padding: 6px 0; border-bottom: 1px solid transparent;
  }
  .nav a:hover { color: var(--ink); }
  .nav a[aria-current='page'] { color: var(--ink); border-bottom-color: var(--laterite); }
  .theme-btn {
    appearance: none; border: 1px solid var(--rule); background: transparent; color: var(--ink-2);
    width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center; cursor: pointer; flex: none;
  }
  .theme-btn svg { width: 16px; }
  .theme-btn:hover { color: var(--ink); border-color: var(--rule-strong); }

  @media (max-width: 760px) {
    .head-inner { flex-wrap: wrap; gap: 0 12px; padding-top: 10px; }
    .brand { order: 1; }
    .theme-btn { order: 2; margin-left: auto; }
    .nav { order: 3; width: 100%; margin: 0; overflow-x: auto; scrollbar-width: none; }
    .nav::-webkit-scrollbar { display: none; }
    .nav ul { gap: 22px; padding: 6px 0 8px; }
    .nav a { white-space: nowrap; display: inline-block; padding: 6px 0; }
  }

  .site-foot { border-top: 1px solid var(--rule); margin-top: clamp(64px, 10vw, 140px); padding: 48px 0 64px; background: var(--paper-2); }
  .foot-inner { display: grid; grid-template-columns: 1fr 1.3fr; gap: 40px; }
  .foot-title { font-family: var(--f-display); font-size: 1.9rem; margin: 0 0 0.3em; }
  .foot-title em { font-style: italic; }
  .foot-line { color: var(--ink-2); max-width: 36ch; }
  .foot-cols { display: grid; grid-template-columns: auto 1fr; gap: 32px; }
  .foot-cols ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .foot-cols a { text-decoration: none; }
  .foot-cols a:hover { text-decoration: underline; }
  .foot-note { color: var(--ink-3); font-size: 0.86rem; margin: 0; max-width: 46ch; }
  @media (max-width: 760px) {
    .foot-inner, .foot-cols { grid-template-columns: 1fr; gap: 24px; }
  }
</style>
