---
import Base from '../layouts/Base.astro';
---
<Base title="Not found">
  <section class="wrap" style="padding-block: clamp(60px,12vw,160px)">
    <p class="label">404 · Off the map</p>
    <h1 style="font-size:clamp(2.6rem,1.4rem + 5vw,5.6rem);font-weight:330;margin:12px 0 20px">This step leads nowhere.</h1>
    <p style="max-width:44ch;color:var(--ink-2)">The page you wanted isn't here. Go back to <a href="/">the plates</a> or <a href="/where-to-look/">the map</a>.</p>
  </section>
</Base>
