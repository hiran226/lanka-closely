---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import Moonstone from '../../components/Moonstone.astro';
import StupaDiagram from '../../components/StupaDiagram.astro';
import IslandMap from '../../components/IslandMap.astro';
import { photo, platePhotos } from '../../lib/photos';
import { placeBySlug } from '../../lib/places';

export async function getStaticPaths() {
  const entries = (await getCollection('entries')).sort((a, b) => a.data.number - b.data.number);
  return entries.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: entries[i - 1], next: entries[i + 1], total: entries.length },
  }));
}
const { entry, prev, next, total } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const no = String(d.number).padStart(2, '0');
const keys = platePhotos[entry.id] ?? [entry.id];
const [lead, ...more] = keys;
const leadPhoto = photo(lead);
const isPortrait = leadPhoto ? leadPhoto.img.height > leadPhoto.img.width : false;

// group places by slug for the mini map
const pinMap = new Map<string, any>();
for (const p of d.places) {
  const pl = placeBySlug(p.placeSlug);
  if (!pl) continue;
  if (!pinMap.has(pl.slug)) pinMap.set(pl.slug, { slug: pl.slug, name: pl.name, lat: pl.lat, lon: pl.lon, layers: [d.layer], count: 0, href: `/where-to-look/#place-${pl.slug}` });
  pinMap.get(pl.slug).count++;
}
const pins = [...pinMap.values()];
---
<Base title={d.title} description={d.summary} image={leadPhoto?.img.src}>
  <article class="plate-page" data-layer={d.layer} data-plate={entry.id} data-total-cues={d.lookFor.length}>
    <header class="wrap plate-head">
      <p class="crumbs label"><a href="/#plates">The plates</a> <span aria-hidden="true">/</span> Plate {no} of {String(total).padStart(2, '0')}</p>
      <div class="head-grid">
        <div>
          <p class={`native ${d.nativeLang}`} lang={d.nativeLang}>{d.native}</p>
          <h1>{d.title}</h1>
          <p class="romanised"><em>{d.romanised}</em></p>
        </div>
        <div class="head-meta">
          <p class="kicker">{d.kicker}</p>
          <dl class="facts">
            <div><dt class="label">Layer</dt><dd><span class="layer" data-layer={d.layer}>{d.layer}</span></dd></div>
            <div><dt class="label">Period</dt><dd>{d.period}</dd></div>
          </dl>
        </div>
      </div>
    </header>

    <div class:list={['wrap lead', { portrait: isPortrait }]}>
      <Photo k={lead} eager sizes={isPortrait ? '(max-width: 760px) 100vw, 45vw' : '(max-width: 1240px) 100vw, 1200px'} widths={[600, 900, 1300, 1800]} />
      <p class="summary">{d.summary}</p>
    </div>

    <div class="wrap body-grid">
      <aside class="field-notes" aria-labelledby="lookfor-h">
        <div class="notes-card">
          <h2 id="lookfor-h" class="label">Look for</h2>
          <ul class="cues">
            {d.lookFor.map((c, i) => (
              <li>
                <label>
                  <input type="checkbox" data-cue={i} />
                  <span class="box" aria-hidden="true" />
                  <span class="cue-text">{c}</span>
                </label>
              </li>
            ))}
          </ul>
          <p class="notes-foot"><span data-cue-count>0</span> of {d.lookFor.length} spotted · <span class="muted">saved on this device only</span></p>
        </div>
      </aside>

      <div class="prose">
        <Content />
      </div>
    </div>

    {entry.id === 'moonstone' && (
      <section class="wrap diagram" aria-labelledby="dia-h">
        <h2 id="dia-h" class="sec-h"><span class="label">Interactive plate</span> Read the rings</h2>
        <Moonstone />
      </section>
    )}
    {entry.id === 'stupa' && (
      <section class="wrap diagram" aria-labelledby="dia-h">
        <h2 id="dia-h" class="sec-h"><span class="label">Interactive plate</span> Take one apart</h2>
        <StupaDiagram />
      </section>
    )}

    {more.length > 0 && (
      <section class="wrap more" aria-label="More photographs">
        <div class:list={['more-grid', `n${more.length}`]}>
          {more.map((k) => <Photo k={k} sizes="(max-width: 760px) 100vw, 50vw" widths={[500, 800, 1200]} />)}
        </div>
      </section>
    )}

    {d.misreadings.length > 0 && (
      <section class="wrap misread" aria-labelledby="mis-h">
        <h2 id="mis-h" class="sec-h"><span class="label">Correcting the record</span> Common misreadings</h2>
        <ol class="mis-list">
          {d.misreadings.map((m) => (
            <li class="reveal">
              <p class="myth"><span class="label">You may hear</span><s>{m.myth}</s></p>
              <p class="truth"><span class="label">Closer to the truth</span>{m.truth}</p>
            </li>
          ))}
        </ol>
      </section>
    )}

    <section class="wrap where" aria-labelledby="where-h">
      <h2 id="where-h" class="sec-h"><span class="label">Field locations</span> Where to see it</h2>
      <div class="where-grid">
        <ol class="where-list">
          {d.places.map((p) => {
            const pl = placeBySlug(p.placeSlug);
            return (
              <li class:list={[{ best: p.best }]}>
                {p.best && <span class="best label">Best example</span>}
                <h3>{p.where}</h3>
                <p class="where-place label">{pl?.name}{pl?.region ? ` · ${pl.region}` : ''}</p>
                <p>{p.note}</p>
              </li>
            );
          })}
        </ol>
        <div class="mini-map"><IslandMap pins={pins} small label={`Where to see the ${d.title.toLowerCase()}`} /></div>
      </div>
    </section>

    {d.respect.length > 0 && (
      <section class="wrap respect" aria-labelledby="resp-h">
        <div class="respect-card">
          <h2 id="resp-h" class="label">Looking respectfully</h2>
          <ul>{d.respect.map((r) => <li>{r}</li>)}</ul>
          <a href="/how-to-look/" class="more-link">The full etiquette notes →</a>
        </div>
      </section>
    )}

    {d.sources.length > 0 && (
      <section class="wrap sources" aria-labelledby="src-h">
        <h2 id="src-h" class="label">Sources</h2>
        <ul>
          {d.sources.map((s) => <li>{s.url ? <a href={s.url} rel="noopener">{s.label}</a> : s.label}</li>)}
        </ul>
      </section>
    )}

    <nav class="wrap pager" aria-label="Plates">
      {prev ? (
        <a href={`/plates/${prev.id}/`} class="pg prev"><span class="label">← Plate {String(prev.data.number).padStart(2, '0')}</span><span class="pg-t">{prev.data.title}</span></a>
      ) : <span />}
      {next ? (
        <a href={`/plates/${next.id}/`} class="pg next"><span class="label">Plate {String(next.data.number).padStart(2, '0')} →</span><span class="pg-t">{next.data.title}</span></a>
      ) : <a href="/where-to-look/" class="pg next"><span class="label">Finished →</span><span class="pg-t">Where to look</span></a>}
    </nav>
  </article>
</Base>

<style>
  .plate-page { --accent: var(--layer-c); }
  .plate-head { padding-top: clamp(28px, 5vw, 64px); }
  .crumbs a { color: inherit; }
  .head-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 24px 48px; align-items: end; margin-top: 18px; padding-bottom: 28px; border-bottom: 1px solid var(--rule-strong); }
  .native { margin: 0 0 0.1em; font-size: clamp(1.4rem, 1rem + 1.6vw, 2.2rem); color: var(--accent); }
  h1 { font-size: clamp(3rem, 1.6rem + 6vw, 7.2rem); line-height: 0.92; font-weight: 350; letter-spacing: -0.03em; }
  .romanised { margin: 0.4em 0 0; color: var(--ink-3); font-size: 1.15rem; }
  .kicker { font-size: clamp(1.25rem, 1rem + 0.8vw, 1.65rem); font-style: italic; line-height: 1.25; margin: 0 0 18px; }
  .facts { display: grid; grid-template-columns: auto 1fr; gap: 6px 20px; margin: 0; }
  .facts div { display: contents; }
  .facts dt { padding-top: 0.3em; }
  .facts dd { margin: 0; }

  .lead { margin-top: 28px; }
  .lead :global(.photo-frame) { aspect-ratio: 16 / 9; }
  .lead.portrait { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1fr); gap: 40px; align-items: end; }
  .lead.portrait :global(.photo-frame) { aspect-ratio: 3 / 4; }
  .summary { font-size: clamp(1.3rem, 1rem + 1vw, 1.9rem); line-height: 1.3; max-width: 34ch; margin: 32px 0 0; font-weight: 350; }
  .lead.portrait .summary { margin: 0 0 40px; }

  .body-grid { display: grid; grid-template-columns: minmax(240px, 0.75fr) minmax(0, 1.6fr); gap: clamp(28px, 5vw, 80px); margin-top: clamp(40px, 6vw, 80px); align-items: start; }
  .field-notes { position: sticky; top: 84px; }
  .notes-card { border: 1px solid var(--rule-strong); padding: 18px 18px 14px; background: var(--paper); box-shadow: 6px 6px 0 var(--paper-3); }
  .notes-card h2 { margin: 0 0 10px; }
  .cues { list-style: none; margin: 0; padding: 0; }
  .cues li + li { border-top: 1px dashed var(--rule); }
  .cues label { display: grid; grid-template-columns: 22px 1fr; gap: 10px; padding: 9px 0; cursor: pointer; align-items: start; }
  .cues input { position: absolute; opacity: 0; pointer-events: none; }
  .box { width: 18px; height: 18px; border: 1.4px solid var(--ink-2); margin-top: 4px; position: relative; transition: background 0.2s; }
  .cues input:checked + .box { background: var(--accent); border-color: var(--accent); }
  .cues input:checked + .box::after { content: ''; position: absolute; left: 5px; top: 1px; width: 5px; height: 10px; border: solid var(--paper); border-width: 0 2px 2px 0; transform: rotate(45deg); }
  .cues input:focus-visible + .box { outline: 2px solid var(--focus); outline-offset: 2px; }
  .cues input:checked ~ .cue-text { color: var(--ink-3); text-decoration: line-through; text-decoration-color: var(--accent); }
  .cue-text { font-size: 0.98rem; line-height: 1.4; }
  .notes-foot { margin: 10px 0 0; font-family: var(--f-mono); font-size: 0.68rem; letter-spacing: 0.04em; text-transform: uppercase; color: var(--ink-2); }
  .muted { color: var(--ink-3); }

  .sec-h { font-size: clamp(2rem, 1.4rem + 2.4vw, 3.4rem); margin-bottom: 28px; display: flex; flex-direction: column; gap: 10px; }
  .diagram, .misread, .where, .more { margin-top: clamp(56px, 8vw, 110px); }
  .diagram { padding-top: 32px; border-top: 1px solid var(--rule-strong); }

  .more-grid { display: grid; gap: 24px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .more-grid.n1 { grid-template-columns: minmax(0, 0.7fr); }
  .more-grid :global(.photo-frame) { aspect-ratio: 4 / 3; }

  .mis-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; counter-reset: m; }
  .mis-list li { display: grid; grid-template-columns: 1fr 1fr; gap: 24px 48px; padding: 22px 0; border-top: 1px solid var(--rule); }
  .mis-list p { margin: 0; display: flex; flex-direction: column; gap: 6px; }
  .myth s { text-decoration-color: var(--laterite); text-decoration-thickness: 1.5px; color: var(--ink-2); font-size: 1.1rem; }
  .truth { font-size: 1.1rem; }

  .where-grid { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(200px, 0.8fr); gap: 48px; align-items: start; }
  .where-list { list-style: none; margin: 0; padding: 0; }
  .where-list li { padding: 20px 0; border-top: 1px solid var(--rule); position: relative; }
  .where-list h3 { font-size: 1.55rem; }
  .where-place { margin: 6px 0 8px; }
  .where-list p:last-child { margin: 0; color: var(--ink-2); max-width: 56ch; }
  .best { display: inline-block; color: var(--accent); margin-bottom: 6px; }
  .best::before { content: '★ '; }
  .mini-map { max-width: 300px; justify-self: center; width: 100%; position: sticky; top: 90px; }

  .respect { margin-top: 64px; }
  .respect-card { background: var(--paper-2); padding: clamp(20px, 3vw, 36px); border-left: 3px solid var(--accent); }
  .respect-card h2 { margin: 0 0 10px; }
  .respect-card ul { margin: 0 0 14px; padding-left: 1.1em; }
  .respect-card li { margin: 4px 0; }
  .more-link { font-family: var(--f-mono); font-size: 0.72rem; letter-spacing: 0.06em; text-transform: uppercase; }

  .sources { margin-top: 48px; }
  .sources ul { margin: 8px 0 0; padding-left: 1.1em; color: var(--ink-2); font-size: 0.9rem; columns: 2; column-gap: 40px; }
  .sources li { break-inside: avoid; margin-bottom: 4px; }

  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 72px; }
  .pg { display: flex; flex-direction: column; gap: 4px; text-decoration: none; padding: 20px 0; border-top: 2px solid var(--ink); }
  .pg.next { text-align: right; }
  .pg-t { font-family: var(--f-display); font-size: clamp(1.4rem, 1rem + 1.4vw, 2.2rem); line-height: 1.05; }
  .pg:hover .pg-t { color: var(--laterite-ink); }

  @media (max-width: 860px) {
    .head-grid, .lead.portrait, .body-grid, .where-grid, .mis-list li { grid-template-columns: 1fr; }
    .head-grid { gap: 16px; }
    .field-notes, .mini-map { position: static; }
    .lead.portrait .summary { margin: 0; }
    .mini-map { max-width: 240px; }
    .sources ul { columns: 1; }
    .more-grid { grid-template-columns: 1fr; }
    .more-grid.n1 { grid-template-columns: 1fr; }
    .lead :global(.photo-frame) { aspect-ratio: 4 / 3; }
    .mis-list li { gap: 12px; }
  }
</style>

<script>
  import { readLog, writeLog } from '../../scripts/log';
  const page = document.querySelector<HTMLElement>('[data-plate]');
  if (page) {
    const id = page.dataset.plate!;
    const boxes = page.querySelectorAll<HTMLInputElement>('input[data-cue]');
    const count = page.querySelector('[data-cue-count]');
    const log = readLog();
    const saved = new Set(log[id] ?? []);
    boxes.forEach((b) => (b.checked = saved.has(Number(b.dataset.cue))));
    const update = () => { if (count) count.textContent = String(page.querySelectorAll('input[data-cue]:checked').length); };
    update();
    boxes.forEach((b) =>
      b.addEventListener('change', () => {
        const l = readLog();
        l[id] = [...boxes].filter((x) => x.checked).map((x) => Number(x.dataset.cue));
        writeLog(l);
        update();
      })
    );
  }
</script>
