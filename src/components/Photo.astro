---
import { Image } from 'astro:assets';
import { photo } from '../lib/photos';
interface Props { k: string; sizes?: string; eager?: boolean; class?: string; caption?: boolean; widths?: number[] }
const { k, sizes = '(max-width: 760px) 100vw, 60vw', eager = false, class: cls, caption = true, widths = [480, 800, 1200, 1600] } = Astro.props;
const p = photo(k);
---
{p && (
  <figure class:list={['photo', cls]}>
    <div class="photo-frame">
      <Image src={p.img} alt={p.credit.alt} widths={widths} sizes={sizes} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} format="webp" quality={78} />
    </div>
    {caption && (
      <figcaption>
        <span class="cap">{p.credit.caption}</span>
        <span class="credit">
          Photo: <a href={p.credit.sourceUrl} rel="noopener">{p.credit.author}</a>,{' '}
          <a href={p.credit.licenseUrl} rel="license noopener">{p.credit.license}</a>
        </span>
      </figcaption>
    )}
  </figure>
)}
<style>
  .photo { margin: 0; }
  .photo-frame { overflow: hidden; background: var(--paper-3); }
  .photo-frame :global(img) { width: 100%; height: 100%; object-fit: cover; }
  figcaption { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 2px 16px; padding-top: 8px; font-size: 0.8rem; color: var(--ink-3); line-height: 1.4; }
  .cap { color: var(--ink-2); font-style: italic; }
  .credit a { color: inherit; }
</style>
