---
import shapes from './map-shapes.svg.txt?raw';
import { toPct } from '../lib/places';
export interface Pin { slug: string; name: string; lat: number; lon: number; layers: string[]; count: number; href?: string }
interface Props { pins: Pin[]; label?: string; small?: boolean }
const { pins, label = 'Map of Sri Lanka showing where to see each detail', small = false } = Astro.props;
// label placement to avoid collisions in the crowded Cultural Triangle; others show on hover
const side: Record<string, 'l' | 'r'> = {
  jaffna: 'r', tiriyaya: 'r', trincomalee: 'r', anuradhapura: 'l', sigiriya: 'l', polonnaruwa: 'r',
  kandy: 'l', 'hill-country': 'r', galle: 'r',
};
---
<div class:list={['island', { small }]} data-island>
  <svg viewBox="0 0 1013.447 1412.572" aria-hidden="true" preserveAspectRatio="xMidYMid meet">
    <g set:html={shapes} />
  </svg>
  <ul class="pins" aria-label={label}>
    {pins.map((p) => {
      const { x, y } = toPct(p.lat, p.lon);
      return (
        <li class="pin" style={`left:${x.toFixed(2)}%;top:${y.toFixed(2)}%`} data-pin={p.slug} data-layers={p.layers.join(' ')} data-side={side[p.slug] ?? 'r'} data-quiet={side[p.slug] ? undefined : ''}>
          <a href={p.href ?? `#place-${p.slug}`} data-layer={p.layers[0]} aria-label={`${p.name}: ${p.count} detail${p.count === 1 ? '' : 's'}`}>
            <span class="dot" />
            <span class="pin-label">{p.name.replace(/ \(.+\)$/, '')}</span>
          </a>
        </li>
      );
    })}
  </ul>
</div>
<style>
  .island { position: relative; aspect-ratio: 1013.447 / 1412.572; width: 100%; }
  .island svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .island :global(.m-land) { fill: var(--paper-2); }
  .island :global(.m-other) { fill: var(--paper-3); }
  .island :global(.m-water) { fill: var(--paper); stroke: var(--rule-strong); stroke-width: 1.6; }
  .island :global(.m-river) { fill: none; stroke: color-mix(in srgb, var(--layer-water) 40%, transparent); stroke-width: 1.2; }
  .island :global(.m-prov) { fill: none; stroke: var(--rule); stroke-width: 1.6; stroke-dasharray: 5 5; }
  .island :global(.m-dist) { display: none; }
  .pins { list-style: none; margin: 0; padding: 0; position: absolute; inset: 0; }
  .pin { position: absolute; width: 0; height: 0; }
  .pin a {
    position: absolute; left: -13px; top: -13px; width: 26px; height: 26px; display: grid; place-items: center;
    text-decoration: none; color: var(--ink); z-index: 1;
  }
  .pin a:hover, .pin a:focus-visible, .pin.is-active a { z-index: 3; }
  .dot {
    width: 13px; height: 13px; border-radius: 50%; background: var(--layer-c, var(--laterite));
    box-shadow: 0 0 0 3px var(--paper), 0 0 0 4px var(--rule-strong); transition: transform 0.25s var(--ease);
  }
  .pin-label {
    position: absolute; top: 50%; transform: translateY(-50%); left: 100%;
    font-family: var(--f-mono); font-size: 0.64rem; letter-spacing: 0.06em; text-transform: uppercase;
    background: color-mix(in srgb, var(--paper) 88%, transparent); padding: 1px 5px; white-space: nowrap; pointer-events: none;
  }
  [data-side='l'] .pin-label { left: auto; right: 100%; }
  [data-quiet] .pin-label { opacity: 0; transition: opacity 0.2s; }
  .pin a:hover .pin-label, .pin a:focus-visible .pin-label, .pin.is-active .pin-label { opacity: 1; }
  .pin a:hover .dot, .pin.is-active .dot { transform: scale(1.35); }
  .pin.is-active .pin-label { background: var(--ink); color: var(--paper); }
  .pin.is-dim { opacity: 0.2; }
  .small .pin-label { display: none; }
  .small .pin a { pointer-events: none; }
  @media (max-width: 600px) { .pin-label { font-size: 0.56rem; } .dot { width: 11px; height: 11px; } }
</style>
